{
  "info": {
    "name": "Tugas 3 - MongoDB Reservasi Ruang Rapat",
    "description": "Tugas 3: API MongoDB. baseUrl menunjuk server lokal; jalankan server dengan MONGODB_URI sebelum koleksi.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "GET - Info API",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 - Info API', function () { pm.response.to.have.status(200); });",
              "pm.test('Memuat metadata Topik 28', function () { const data = pm.response.json(); pm.expect(data.nomorTopik).to.eql(28); pm.expect(data.nim).to.eql('2428240101'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "GET - Semua reservasi",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/meeting-reservations"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 - Data reservasi', function () { pm.response.to.have.status(200); });",
              "pm.test('Response berupa array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "GET - Filter Pagination Sorting Projection",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/meeting-reservations?ruang=Ruang%20Kenanga&page=1&limit=5&sort=-tanggal&fields=ruang,tanggal,pemesan.nama"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 - daftar paginasi', function () { pm.response.to.have.status(200); });",
              "pm.test('Response memuat data dan pagination', function () { const d=pm.response.json(); pm.expect(d.data).to.be.an('array'); pm.expect(d.pagination.page).to.eql(1); pm.expect(d.pagination.limit).to.eql(5); });"
            ]
          }
        }
      ]
    },
    {
      "name": "GET - Filter tanggal",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/meeting-reservations?tanggal=2026-10-05"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 - Filter tanggal', function () { pm.response.to.have.status(200); });",
              "pm.test('Semua hasil sesuai tanggal', function () { pm.response.json().forEach(item => pm.expect(item.tanggal).to.eql('2026-10-05')); });"
            ]
          }
        }
      ]
    },
    {
      "name": "POST - Tambah reservasi (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"namaPemesan\": \"PT Uji Postman\",\n  \"ruang\": \"Ruang Kenanga\",\n  \"tanggal\": \"2026-10-09\",\n  \"jamMulai\": \"13:00\",\n  \"durasiJam\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/meeting-reservations"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201 - Reservasi dibuat', function () { pm.response.to.have.status(201); });",
              "pm.test('Response menyertakan ID baru', function () { pm.expect(pm.response.json().data.id).to.be.a('number'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "POST - Gagal field wajib kosong (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"namaPemesan\": \"\",\n  \"ruang\": \"Ruang Kenanga\",\n  \"tanggal\": \"2026-10-05\",\n  \"jamMulai\": \"13:00\",\n  \"durasiJam\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/meeting-reservations"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400 - Validasi field wajib', function () { pm.response.to.have.status(400); });",
              "pm.test('Error response JSON', function () { pm.expect(pm.response.json().status).to.eql('error'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "GET - Endpoint tidak ditemukan (404 JSON)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/endpoint-salah"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404 - Endpoint tidak tersedia', function () { pm.response.to.have.status(404); });",
              "pm.test('Response error JSON', function () { pm.expect(pm.response.json().message).to.eql('Endpoint tidak ditemukan'); });"
            ]
          }
        }
      ]
    }
  ]
}
